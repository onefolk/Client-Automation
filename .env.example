# ==============================================================================
# OneFolk Client Intelligence Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
PORT=8000
API_PORT=8000
API_HOST=0.0.0.0
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (PostgreSQL)
POSTGRES_USER=onefolk
POSTGRES_PASSWORD=onefolk_secret_dev
POSTGRES_DB=onefolk_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://onefolk:onefolk_secret_dev@localhost:5432/onefolk_intelligence

# Redis (Streams, Jobs, SSE Event Bus)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# AI Intelligence (Grok)
GROK_API_KEY=grok_mock_or_real_key_here
GROK_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1

# Crawler / Automation Settings
CRAWLER_USER_AGENT=OneFolkClientBot/1.0 (+https://onefolk.ai/bot)
CRAWLER_TIMEOUT_MS=10000
CRAWLER_MAX_CONCURRENCY=5
PLAYWRIGHT_WS_ENDPOINT=

# Logging
RUST_LOG=info,api=debug,worker=debug,domain=debug,providers=debug,discovery=debug,events=debug
