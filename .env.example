# ==============================================================================
# OneFolk Outreach Engine — Cloud Configuration Template
# ==============================================================================
# Copy this file to .env for local testing or populate these secrets in
# GitHub Actions Repository Secrets and Variables.
# NEVER commit real credentials, service account keys, or API tokens to git.

# ------------------------------------------------------------------------------
# Google Cloud & Sheets Integration
# ------------------------------------------------------------------------------
# The ID of the existing master Google Spreadsheet
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=1U3JxQUcxSyqfZySnHNdLIwExtr3ikfcYlj0a3YY7ATM

# Minified JSON string of the Google Cloud Service Account key.
# The service account email must be added as 'Editor' to the master Google Sheet.
# Example: {"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"outreach-bot@your-project.iam.gserviceaccount.com"}

# ------------------------------------------------------------------------------
# Groq Free Tier LLM Configuration
# ------------------------------------------------------------------------------
# Free-tier API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_free_api_key_here

# Groq model ID (free models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
GROQ_MODEL=openai/gpt-oss-120b

# Maximum AI completions allowed per run to respect daily token/request budgets
MAX_AI_CALLS=120

# ------------------------------------------------------------------------------
# Discovery & Research Controls
# ------------------------------------------------------------------------------
# Target number of genuinely qualified leads per discovery run
QUALIFIED_TARGET=100

# Maximum number of HTTP fetches allowed per discovery execution
MAX_HTTP_FETCHES=500

# Maximum external links to follow from directory pages
MAX_DIRECTORY_LINKS=600

# Crawl HTTP request timeout in seconds
HTTP_TIMEOUT_SECONDS=10

# Active campaign preset from config/campaigns.json
ACTIVE_CAMPAIGN=all_industries_pilot

# ------------------------------------------------------------------------------
# Safety & Email Sending Controls
# ------------------------------------------------------------------------------
# Master kill-switch: sending is DISABLED by default.
# Must be explicitly set to 'true' or 'YES' in Apps Script Properties to enable live sending.
ENABLE_SENDING=false

# Maximum outbound recipients per calendar day (hard application limit is 50)
MAX_DAILY_SENDS=50
